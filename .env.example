# Copy this file to .env and add your own key. Never commit .env.
# Provider for local automatic investigations: openrouter or openai.
AOI_LLM_PROVIDER=openrouter

# OpenRouter free model. Free IDs end in :free. No paid-model fallback is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional OpenAI alternative: set AOI_LLM_PROVIDER=openai and configure this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Incident attention and notification demo. Simulated mode makes no network email request.
AOI_EMAIL_MODE=simulated
AOI_PRIMARY_EMAIL=payments-lead@example.test
AOI_BACKUP_EMAIL=payments-backup@example.test
AOI_APP_URL=http://127.0.0.1:5173
AOI_OPERATOR_DISPLAY_NAME=Local operator
AOI_ACK_TIMEOUT_SECONDS=600

# Optional real SMTP mode; configure deliberately before setting AOI_EMAIL_MODE=smtp.
AOI_SMTP_HOST=
AOI_SMTP_PORT=587
AOI_SMTP_USERNAME=
AOI_SMTP_PASSWORD=
AOI_SMTP_FROM=
AOI_SMTP_STARTTLS=true

# Configurable MVP attention policy defaults (not empirically validated thresholds).
AOI_TRUST_SERVICE_LOGS=true
AOI_CRITICAL_PAYMENT_ERROR_RATE=0.10
AOI_CRITICAL_SERVICE_ERROR_RATE=0.10
AOI_CRITICAL_ORDERS_QUEUE_DEPTH=100
AOI_CRITICAL_DELIVERY_P95_MS=1000
